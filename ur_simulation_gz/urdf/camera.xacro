<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:property name="camera_name"   value="camera" />
    <xacro:property name="update_rate"   value="10" />
    <xacro:property name="horizontal_fov" value="1.089" />
    <xacro:property name="img_width"     value="640" />
    <xacro:property name="img_height"    value="480" />
    <xacro:property name="img_format"    value="R8G8B8" />
    <xacro:property name="near_clip"     value="0.05" />
    <xacro:property name="far_clip"      value="8.0" />
    
    <xacro:property name="noise_mean"    value="0.0" />
    <xacro:property name="noise_stddev"  value="0.007" />
    <xacro:property name="distortion_k1" value="-0.1" />
    <xacro:property name="distortion_k2" value="0.01" />
    <xacro:property name="focal_length"  value="525" /> 
    
    <material name="red"><color rgba="1 0 0 1"/></material>
    
    <joint name="${camera_name}_joint" type="fixed">
        <parent link="tool0"/>
        <child link="${camera_name}_link"/>
        <origin xyz="0.0 -0.1 0.0" rpy="3.14 -1.57 -1.57"/>
    </joint>

    <link name="${camera_name}_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <!-- Rotation from the body frame (camera_link, which is what the Gazebo
         sensor renders from, +X forward along the boresight) to the ROS
         optical frame per REP 103 (camera_link_optical, +Z forward, +X
         right, +Y down). Without it the two frames coincide, so anything
         treating camera_link_optical as an optical frame is off by 90
         degrees on two axes and aims the camera sideways instead of where
         it should look. That is what the behavior tree nodes aiming the
         camera use.
         Note that the sensor data below is NOT tagged with this frame. What
         Gazebo puts on the wire (points in particular) is in the body
         convention, so it is labelled camera_link instead. Rotating this
         frame is about aiming the arm; labelling the data is about reading
         what comes back, and the two want different frames here. -->
    <joint name="${camera_name}_optical_joint" type="fixed">
        <parent link="${camera_name}_link"/>
        <child link="${camera_name}_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="${camera_name}_link_optical"></link>

    <gazebo reference="${camera_name}_link">
        <material>Gazebo/Red</material>

        <sensor name="${camera_name}" type="rgbd_camera">
            <pose> 0 0 0 0 0 0 </pose>
            <always_on>1</always_on>
            <update_rate>${update_rate}</update_rate>
            <visualize>true</visualize>
            <topic>${camera_name}</topic>
            <!-- camera_link, not camera_link_optical. Gazebo publishes the
                 point cloud in this sensor body frame (+X forward), so the
                 data has to be labelled with a frame that follows the same
                 convention or it lands rotated 90 degrees in RViz. -->
            <gz_frame_id>${camera_name}_link</gz_frame_id>
            
            <camera>
                <horizontal_fov>${horizontal_fov}</horizontal_fov>
                <image>
                    <format>${img_format}</format>
                    <width>${img_width}</width>
                    <height>${img_height}</height>
                </image>
                <clip>
                    <near>${near_clip}</near>
                    <far>${far_clip}</far>
                </clip>
                
                <noise>
                    <type>gaussian</type>
                    <mean>${noise_mean}</mean>
                    <stddev>${noise_stddev}</stddev>
                </noise>

                <lens>
                    <intrinsics>
                        <fx>${focal_length}</fx>
                        <fy>${focal_length}</fy>
                        <cx>${img_width/2}</cx>
                        <cy>${img_height/2}</cy>
                        <s>0</s>
                    </intrinsics>
                    <distortion>
                        <k1>${distortion_k1}</k1>
                        <k2>${distortion_k2}</k2>
                        <k3>0.0</k3>
                        <p1>0.0</p1>
                        <p2>0.0</p2>
                        <center>0.5 0.5</center>
                    </distortion>
                </lens>
            </camera>
        </sensor>
    </gazebo>
</robot>